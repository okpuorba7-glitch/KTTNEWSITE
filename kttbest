.cinfo{display:flex;gap:13px;margin-bottom:20px;}
.cinfo-ico{width:40px;height:40px;border-radius:9px;background:#1A1A1A;border:1px solid #2A2A2A;display:flex;align-items:center;justify-content:center;font-size:16px;flex-shrink:0;}
.cinfo h4{font-size:12px;font-weight:700;margin-bottom:4px;color:#ffffff;text-transform:uppercase;letter-spacing:.5px;}
.cinfo p{font-size:14px;color:#D4D4D8;font-weight:400;line-height:1.6;word-break:break-all;}
.wa-btn{display:inline-flex;align-items:center;gap:8px;background:#25D366;color:#ffffff;border:none;cursor:pointer;padding:12px 20px;border-radius:8px;font-size:14px;font-weight:700;text-decoration:none;margin-top:8px;transition:background .2s;}
.wa-btn:hover{background:#20BC5B;}

/* ABOUT */
.about-grid{display:grid;grid-template-columns:1fr 1fr;gap:68px;align-items:center;}
.about-stats{display:grid;grid-template-columns:1fr 1fr;gap:13px;}
.astat{background:#1A1A1A;border-radius:13px;padding:24px 18px;border:1px solid #2A2A2A;text-align:center;}
.astat.hl{background:#1A0D00;border-color:#FF5E00;}
.astat-num{font-size:30px;font-weight:800;margin-bottom:4px;}
.astat p{font-size:12px;color:#D4D4D8;text-transform:uppercase;letter-spacing:.5px;font-weight:600;}

/* PAGE HERO */
.page-hero{background:#111111;padding:130px 5% 48px;border-bottom:1px solid #2A2A2A;position:relative;overflow:hidden;}
.page-hero::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,#FF5E00,#39FF14);}
.page-hero-inner{max-width:1200px;margin:0 auto;}
.page-hero h1{font-size:36px;font-weight:800;letter-spacing:-.5px;margin-bottom:8px;color:#ffffff;}
.page-hero p{font-size:16px;color:#D4D4D8;font-weight:400;}

/* FOOTER */
.footer{background:#0A0A0A;padding:70px 5% 30px;border-top:1px solid var(--border-color);}
.footer-inner{max-width:1200px;margin:0 auto;}
.footer-bar{height:4px;background:linear-gradient(90deg,var(--bright-orange),var(--neon-lime));border-radius:2px;margin-bottom:56px;}
.footer-grid{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:32px;margin-bottom:40px;}
.footer-brand p{font-size:14px;line-height:1.7;font-weight:400;margin-top:12px;color:#D4D4D8;max-width:280px;}
.footer-col h4{font-size:11px;font-weight:700;color:#F4F4F5;margin-bottom:13px;letter-spacing:2px;text-transform:uppercase;}
.footer-col ul{list-style:none;display:flex;flex-direction:column;gap:9px;}
.footer-col ul li{font-size:13px;font-weight:400;cursor:pointer;color:#D4D4D8;transition:color .2s;word-break:break-all;}
.footer-col ul li:hover{color:#ffffff;}
.footer-div{border:none;border-top:1px solid #2A2A2A;margin-bottom:20px;}
.footer-btm{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px;}
.footer-btm p{font-size:12px;color:#A1A1AA;}
.footer-links{display:flex;gap:16px;}
.footer-links span{font-size:12px;color:#A1A1AA;cursor:pointer;}
.wa-float{position:fixed;bottom:20px;right:20px;z-index:999;width:50px;height:50px;border-radius:50%;background:#25D366;display:flex;align-items:center;justify-content:center;font-size:22px;box-shadow:0 4px 18px rgba(37,211,102,.4);text-decoration:none;transition:transform .2s;}
.wa-float:hover{transform:scale(1.09);}
.success{background:rgba(57,255,20,.06);border:1px solid rgba(57,255,20,.25);border-radius:13px;padding:44px;text-align:center;}
.success h3{font-size:20px;font-weight:800;color:#39FF14;margin-bottom:8px;}
.success p{color:#D4D4D8;font-size:14px;}
.cta-strip{background:#0A0A0A;padding:56px 5%;text-align:center;border-top:1px solid #2A2A2A;}

/* ADMIN */
.admin-overlay{position:fixed;inset:0;background:rgba(0,0,0,.88);z-index:9999;display:flex;align-items:center;justify-content:center;padding:20px;}
.admin-login{background:#111111;border:1px solid #2A2A2A;border-radius:18px;padding:44px 38px;width:100%;max-width:400px;text-align:center;}
.admin-login h2{font-size:20px;font-weight:800;color:#ffffff;margin-bottom:5px;}
.admin-login p{font-size:13px;color:#D4D4D8;margin-bottom:24px;}
.admin-login-btn{width:100%;padding:12px;border-radius:8px;background:#FF5E00;color:#ffffff;border:none;cursor:pointer;font-size:15px;font-weight:800;margin-top:4px;transition:background .2s;}
.admin-login-btn:hover{background:#FF7A28;}
.admin-hint{font-size:11px;color:#A1A1AA;margin-top:14px;}
.admin-wrap{min-height:100vh;background:#0A0A0A;}
.admin-tabs{display:flex;background:#111111;border-bottom:1px solid #2A2A2A;padding:0 5%;overflow-x:auto;scrollbar-width:none;}
.admin-tabs::-webkit-scrollbar{display:none;}
.admin-tab{padding:13px 18px;font-size:13px;font-weight:600;color:#D4D4D8;cursor:pointer;border:none;background:none;white-space:nowrap;border-bottom:2px solid transparent;margin-bottom:-1px;transition:color .15s;}
.admin-tab:hover{color:#ffffff;}
.admin-tab.active{color:#39FF14;border-bottom-color:#39FF14;}
.admin-body{max-width:1080px;margin:0 auto;padding:28px 5%;}
.admin-sec-title{font-size:17px;font-weight:700;color:#ffffff;margin-bottom:5px;}
.admin-sec-sub{font-size:13px;color:#D4D4D8;margin-bottom:24px;}
.admin-stats-row{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:24px;}
.admin-stat{background:#1A1A1A;border-radius:11px;border:1px solid #2A2A2A;padding:18px;}
.admin-stat-n{font-size:26px;font-weight:800;margin-bottom:3px;}
.admin-stat-l{font-size:11px;color:#D4D4D8;text-transform:uppercase;letter-spacing:.5px;}
.admin-stat-c{font-size:11px;color:#A1A1AA;margin-top:4px;}
.admin-card{background:#1A1A1A;border-radius:13px;border:1px solid #2A2A2A;overflow:hidden;margin-bottom:20px;}
.admin-card-hdr{padding:14px 18px;border-bottom:1px solid #2A2A2A;display:flex;align-items:center;gap:9px;}
.admin-card-hdr h3{font-size:14px;font-weight:700;color:#ffffff;}
.admin-card-body{padding:18px;}
.svc-editor-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-bottom:28px;}
.af{margin-bottom:13px;}
.af label{display:block;font-size:11px;font-weight:700;color:#D4D4D8;letter-spacing:.5px;text-transform:uppercase;margin-bottom:5px;}
.af input,.af textarea,.af select{width:100%;padding:9px 12px;border-radius:7px;border:1.5px solid #2A2A2A;background:#0A0A0A;color:#ffffff;font-size:13px;outline:none;transition:border-color .2s;}
.af input:focus,.af textarea:focus{border-color:#39FF14;}
.af textarea{resize:vertical;min-height:65px;}
.price-row{display:grid;grid-template-columns:1fr 1fr;gap:10px;}
.feat-list{display:flex;flex-direction:column;gap:7px;margin-bottom:9px;}
.feat-row{display:flex;gap:7px;align-items:center;}
.feat-row input{flex:1;padding:7px 10px;border-radius:6px;border:1.5px solid #2A2A2A;background:#0A0A0A;color:#ffffff;font-size:12px;outline:none;}
.feat-row input:focus{border-color:#39FF14;}
.feat-del{background:none;border:none;cursor:pointer;color:#71717A;font-size:15px;padding:3px;transition:color .2s;}
.feat-del:hover{color:#e53935;}
.feat-add{background:none;border:1px dashed #2A2A2A;color:#A1A1AA;cursor:pointer;padding:7px 13px;border-radius:7px;font-size:12px;font-weight:600;width:100%;transition:all .2s;}
.feat-add:hover{border-color:#39FF14;color:#39FF14;}
.media-drop{border:2px dashed #2A2A2A;border-radius:9px;padding:22px;text-align:center;cursor:pointer;transition:all .2s;position:relative;}
.media-drop:hover{border-color:#39FF14;background:rgba(57,255,20,.04);}
.media-drop input{position:absolute;inset:0;opacity:0;cursor:pointer;width:100%;height:100%;}
.media-drop-ico{font-size:26px;margin-bottom:4px;}
.media-drop p{font-size:12px;color:#A1A1AA;margin-top:4px;}
.media-grid-a{display:grid;grid-template-columns:repeat(4,1fr);gap:7px;margin-top:10px;}
.media-item{position:relative;border-radius:7px;overflow:hidden;aspect-ratio:1;border:1px solid #2A2A2A;}
.media-item img,.media-item video{width:100%;height:100%;object-fit:cover;}
.media-del{position:absolute;top:3px;right:3px;background:rgba(0,0,0,.7);border:none;cursor:pointer;color:#ffffff;font-size:12px;width:20px;height:20px;border-radius:50%;display:flex;align-items:center;justify-content:center;}
.media-del:hover{background:#e53935;}
.media-badge{position:absolute;bottom:3px;left:3px;background:rgba(0,0,0,.7);color:#ffffff;font-size:9px;font-weight:700;padding:2px 5px;border-radius:3px;}
.plans-editor-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;}
.plan-editor{background:#1A1A1A;border-radius:13px;border:1px solid #2A2A2A;overflow:hidden;}
.plan-editor-hdr{padding:13px 16px;border-bottom:1px solid #2A2A2A;display:flex;align-items:center;justify-content:space-between;}
.plan-editor-hdr h3{font-size:14px;font-weight:700;color:#ffffff;}
.feat-toggle{display:flex;align-items:center;gap:5px;font-size:11px;color:#D4D4D8;cursor:pointer;}
.feat-toggle input{accent-color:#FF5E00;}
.plan-editor-body{padding:16px;}
.settings-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px;}
.settings-card{background:#1A1A1A;border-radius:13px;border:1px solid #2A2A2A;padding:22px;}
.settings-card h3{font-size:14px;font-weight:700;color:#ffffff;margin-bottom:14px;}
.bk-table{width:100%;border-collapse:collapse;}
.bk-table th{font-size:10px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;color:#A1A1AA;padding:9px 13px;text-align:left;border-bottom:1px solid #2A2A2A;}
.bk-table td{font-size:13px;color:#E4E4E7;padding:11px 13px;border-bottom:1px solid #2A2A2A;font-weight:400;}
.bk-table tr:hover td{background:#1A1A1A;}
.status{display:inline-flex;padding:3px 9px;border-radius:20px;font-size:10px;font-weight:700;}
.status.new{background:rgba(255,94,0,.15);color:#FF5E00;}
.status.done{background:rgba(57,255,20,.1);color:#39FF14;}
.save-bar{position:sticky;bottom:0;background:#111111;border-top:1px solid #2A2A2A;padding:13px 5%;display:flex;align-items:center;justify-content:space-between;z-index:10;}
.save-bar p{font-size:13px;color:#D4D4D8;}
.save-btn{background:#39FF14;color:#000000;border:none;cursor:pointer;padding:10px 26px;border-radius:8px;font-size:14px;font-weight:800;transition:opacity .2s;}
.save-btn:hover{opacity:.85;}
.saved-msg{font-size:13px;color:#39FF14;display:flex;align-items:center;gap:5px;}

/* LAUNDRY CALCULATOR MOBILE & RESPONSIVE FIT */
.laundry-calc-box {
  background: #0D0D0D;
  border: 1px solid #2B3A2B;
  border-radius: 14px;
  padding: 18px 20px;
  margin-top: 12px;
  margin-bottom: 16px;
}

.laundry-qty-btn {
  width: 34px;
  height: 34px;
  border-radius: 8px;
  font-weight: 800;
  font-size: 16px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  touch-action: manipulation;
  user-select: none;
}

.laundry-qty-input {
  width: 48px;
  height: 34px;
  text-align: center;
  font-weight: 800;
  font-size: 14px;
  border-radius: 8px;
  outline: none;
}

@media (max-width: 640px) {
  .laundry-calc-box {
    padding: 14px 10px;
    border-radius: 12px;
  }
  .laundry-desktop-table {
    display: none !important;
  }
  .laundry-mobile-card-list {
    display: flex !important;
    flex-direction: column;
    gap: 8px;
  }
  .laundry-qty-btn {
    width: 38px;
    height: 38px;
    font-size: 18px;
  }
  .laundry-qty-input {
    width: 52px;
    height: 38px;
    font-size: 15px;
  }
}

@media (min-width: 641px) {
  .laundry-mobile-card-list {
    display: none !important;
  }
  .laundry-desktop-table {
    display: block !important;
  }
}

/* RESPONSIVE */
html, body {
  overflow-x: hidden;
  max-width: 100vw;
}

@media(max-width:900px){
  .tabs{
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 5px;
    padding: 8px 6px;
    overflow-x: visible;
  }
  .tabs::-webkit-scrollbar { display: none; }
  .tab{
    flex: 1 1 calc(25% - 6px);
    min-width: max-content;
    padding: 7px 8px;
    font-size: 11.5px;
    gap: 4px;
    border-radius: 8px;
    border: 1px solid rgba(255,255,255,0.08);
    background: rgba(255,255,255,0.03);
    text-align: center;
    white-space: nowrap;
    justify-content: center;
  }
  
  .stats-grid{grid-template-columns:repeat(2,1fr);gap:10px;}
  .stat-item{padding:14px 10px;border-radius:12px;}
  .stat-num{font-size:24px;}
  .stat-label{font-size:10px;letter-spacing:0.8px;}
  .about-stats{grid-template-columns:repeat(2,1fr);gap:10px;}
  .astat{padding:16px 12px;}
  .astat-num{font-size:24px;}
  
  .cards-grid,.svc-editor-grid,.plans-editor-grid,.settings-grid,.admin-stats-row{grid-template-columns:1fr;}
  .why-grid,.plans-grid,.testi-grid,.contact-grid,.about-grid{grid-template-columns:1fr;}
  .footer-grid{grid-template-columns:1fr;}
  .nav-links,.btn-orange,.btn-admin{display:none;}
  .hamburger{display:flex;}
  .fg{grid-template-columns:1fr;}
  .f.full{grid-column:1;}
  .headline{font-size:36px;letter-spacing:-1px;}
  .tagline{font-size:16px;margin-bottom:28px;}
  .hero-wrap{padding:85px 4% 30px;}
  .page-hero{padding:85px 4% 30px;}
  .stats-row{flex-wrap:wrap;}
  .stat-cell{min-width:48%;border-bottom:1px solid #2A2A2A;}
  .price-row{grid-template-columns:1fr;}
  .media-grid-a{grid-template-columns:repeat(3,1fr);}
  .admin-stats-row{grid-template-columns:1fr 1fr;}
  .sec-title{font-size:24px;}
  .sec{padding:40px 4%;}
  .form-box{padding:20px 16px;}
  .plan-card{padding:24px 18px;}
}

@media(max-width:480px){
  .headline{font-size:28px;line-height:1.15;}
  .tagline{font-size:14px;line-height:1.55;}
  .pill{font-size:10px;padding:5px 12px;margin-bottom:14px;}
  .svc-body{padding:18px 18px 8px;gap:10px;}
  .svc-num{font-size:38px;}
  .svc-icon{width:44px;height:44px;font-size:22px;}
  .svc-price-box{margin:0 14px;padding:6px 10px;}
  .svc-feats{padding:8px 14px 4px;}
  .svc-footer{padding:12px 14px 14px;}
  .hero-search{padding:13px 40px 13px 16px;font-size:14px;}
  .search-ico{right:14px;font-size:16px;}
  .footer{padding:40px 4% 24px;}
  .wa-float{width:46px;height:46px;font-size:20px;bottom:16px;right:16px;}
}

