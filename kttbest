@import "tailwindcss";

:root {
  --neon-lime: #39FF14;
  --bright-orange: #FF5E00;
  --bg-dark: #0A0A0A;
  --card-bg: #111111;
  --border-color: #2A2A2A;
}

@theme {
  --font-sans: "DM Sans", ui-sans-serif, system-ui, sans-serif;
  --color-neon-lime: var(--neon-lime);
  --color-bright-orange: var(--bright-orange);
}

@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700;800&family=Playfair+Display:ital,wght@0,700;0,900;1,700;1,900&display=swap');

*{box-sizing:border-box;margin:0;padding:0;}
html,body,#root{background:var(--bg-dark) !important;color:#ffffff;min-height:100%;}
.fd{font-family:'Playfair Display',serif;}

.headline em {
  font-family: 'Playfair Display', serif;
  font-style: italic;
  color: var(--bright-orange);
}
::-webkit-scrollbar{width:5px;}
::-webkit-scrollbar-thumb{background:#FF5E00;border-radius:3px;}

/* NAV */
.nav{position:fixed;top:0;left:0;right:0;z-index:999;background:#111111;border-bottom:2px solid #2A2A2A;display:flex;align-items:center;justify-content:space-between;padding:0 5%;height:66px;}
.nav-logo{display:flex;align-items:center;gap:11px;cursor:pointer;}
.logo-name{font-size:15px;font-weight:700;color:#ffffff;line-height:1.1;}
.logo-name span{color:#39FF14;}
.logo-sub{font-size:10px;color:#A1A1AA;letter-spacing:.4px;}
.nav-links{display:flex;gap:2px;}
.nav-btn{font-size:13px;font-weight:600;color:#E4E4E7;cursor:pointer;border:none;background:none;padding:6px 13px;border-radius:6px;transition:color .15s,background .15s;}
.nav-btn:hover{color:#ffffff;background:#1A1A1A;}
.nav-btn.active{color:#39FF14;}
.nav-right{display:flex;align-items:center;gap:8px;}
.btn-orange{background:var(--bright-orange);color:#000;border:none;cursor:pointer;padding:12px 24px;border-radius:12px;font-size:14px;font-weight:700;transition:all .2s;display:inline-flex;align-items:center;justify-content:center;gap:8px;}
.btn-orange:hover{opacity:.9;transform:translateY(-2px);}
.btn-admin{background:#1A1A1A;color:#E4E4E7;border:1px solid #2A2A2A;cursor:pointer;padding:7px 14px;border-radius:7px;font-size:12px;font-weight:600;transition:all .2s;}
.btn-admin:hover{border-color:var(--bright-orange);color:var(--bright-orange);}
.btn-lime{background:var(--neon-lime);color:#000;border:none;cursor:pointer;padding:12px 24px;border-radius:12px;font-size:14px;font-weight:700;transition:all .2s;display:inline-flex;align-items:center;justify-content:center;gap:8px;}
.btn-lime:hover{opacity:.9;transform:translateY(-2px);}
.hamburger{display:none;background:none;border:none;cursor:pointer;flex-direction:column;gap:5px;padding:4px;}
.hamburger span{display:block;width:22px;height:2px;background:#ffffff;border-radius:2px;}

/* HERO */
.hero-wrap{background:var(--bg-dark);padding:130px 5% 40px;border-bottom:1px solid var(--border-color);}
.hero-inner{max-width:800px;margin:0 auto;text-align:center;}
.pill{display:inline-flex;align-items:center;gap:8px;background:rgba(57, 255, 20, 0.1);border:1px solid rgba(57, 255, 20, 0.3);color:var(--neon-lime);padding:6px 16px;border-radius:99px;font-size:11px;font-weight:700;letter-spacing:2px;margin-bottom:20px;text-transform:uppercase;}
.headline{font-size:52px;font-weight:800;letter-spacing:-1.8px;margin-bottom:15px;line-height:1.05;color:#fff;}
.headline em{font-family:'Playfair Display',serif;font-style:italic;color:var(--bright-orange);}
.tagline{color:#E4E4E7;font-size:19px;max-width:640px;margin:0 auto 35px;line-height:1.65;font-weight:400;}
.hero-search-wrap{position:relative;max-width:520px;margin:0 auto;}
.hero-search{width:100%;padding:15px 50px 15px 22px;border-radius:40px;border:2px solid #333333;background:#1A1A1A;color:#ffffff;font-size:15px;outline:none;transition:border-color .2s;}
.hero-search::placeholder{color:#A1A1AA;}
.hero-search:focus{border-color:var(--bright-orange);}
.search-ico{position:absolute;right:18px;top:50%;transform:translateY(-50%);font-size:18px;opacity:.7;}

/* TABS */
.tabs{background:#111111;display:flex;justify-content:center;align-items:center;border-bottom:1px solid var(--border-color);width:100%;box-sizing:border-box;padding:8px 12px;gap:6px;}
.tabs::-webkit-scrollbar{display:none;}
.tab{padding:10px 16px;font-size:13px;font-weight:700;color:#D4D4D8;cursor:pointer;border:1px solid rgba(255,255,255,0.08);background:rgba(255,255,255,0.02);border-radius:10px;transition:all .15s;text-align:center;display:inline-flex;align-items:center;justify-content:center;gap:6px;white-space:nowrap;}
.tab:hover{color:#ffffff;background:rgba(255,255,255,0.06);border-color:rgba(255,255,255,0.18);}
.tab.active{color:var(--bright-orange);border-color:rgba(255,94,0,0.5);background:rgba(255,94,0,0.12);}

/* DASHBOARD */
.dash{background:var(--bg-dark);padding:32px 5% 50px;}
.dash-inner{max-width:1200px;margin:0 auto;}
.dash-lbl{font-size:11px;font-weight:800;letter-spacing:4px;text-transform:uppercase;color:#A1A1AA;margin-bottom:20px;text-align:center;}

/* STATS GRID */
.stats-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:32px;}
.stat-item{background:var(--card-bg);border:1px solid var(--border-color);border-radius:16px;padding:20px 14px;text-align:center;box-shadow:0 4px 14px rgba(0,0,0,0.3);transition:transform 0.2s, border-color 0.2s;}
.stat-item:hover{border-color:#444;transform:translateY(-2px);}
.stat-num{font-size:clamp(22px, 3.5vw, 32px);font-weight:800;display:block;margin-bottom:4px;line-height:1.1;font-family:'Playfair Display', serif, system-ui;}
.stat-label{font-size:11px;color:#D4D4D8;text-transform:uppercase;letter-spacing:1px;font-weight:600;}

/* SERVICE CARDS */
.cards-grid{display:grid;grid-template-columns:repeat(auto-fit, minmax(250px, 1fr));gap:20px;}
.svc-card{background:var(--card-bg);border-radius:20px;border:1px solid var(--border-color);overflow:hidden;cursor:pointer;display:flex;flex-direction:column;transition:transform .2s,box-shadow .2s,border-color .2s;position:relative;}
.svc-card:hover{transform:translateY(-6px);border-color:#444;}
.svc-card.food:hover{box-shadow:0 12px 40px rgba(57,255,20,.1);}
.svc-card.laundry:hover{box-shadow:0 12px 40px rgba(255,94,0,.1);}
.svc-card.bar:hover{box-shadow:0 12px 40px rgba(255,187,0,.15);}
.svc-stripe{height:4px;width:100%;}
.svc-body{padding:24px 24px 10px;display:flex;justify-content:space-between;gap:15px;}
.svc-lbl{font-size:11px;font-weight:800;letter-spacing:2.5px;text-transform:uppercase;margin-bottom:10px;}
.svc-num{font-size:52px;font-weight:900;line-height:1;margin-bottom:8px;font-family:'Playfair Display',serif;opacity:0.7;}
.svc-title{font-size:18px;font-weight:700;color:#ffffff;margin-bottom:6px;}
.svc-sub{font-size:14px;color:#D4D4D8;line-height:1.6;font-weight:400;}
.svc-icon{width:52px;height:52px;border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:26px;flex-shrink:0;background:#1A1A1A;border:1px solid var(--border-color);}
.svc-bar-wrap{padding:12px 20px 4px;}
.svc-bar-bg{height:4px;border-radius:2px;background:#2A2A2A;overflow:hidden;}
.svc-bar-fill{height:100%;border-radius:2px;width:100%;}
.svc-price-box{margin:0 20px;background:rgba(255,94,0,.12);border:1px solid rgba(255,94,0,.3);border-radius:8px;padding:7px 11px;display:flex;gap:14px;flex-wrap:wrap;}
.price-item{font-size:12px;color:#F4F4F5;}
.price-item strong{color:#FF5E00;font-weight:700;}
.svc-feats{padding:10px 20px 4px;display:flex;flex-direction:column;gap:7px;}
.svc-feat{font-size:13px;color:#F4F4F5;font-weight:400;display:flex;align-items:center;gap:8px;}
.svc-media-row{padding:8px 20px 4px;display:flex;gap:7px;overflow-x:auto;scrollbar-width:none;}
.svc-media-row::-webkit-scrollbar{display:none;}
.media-t{width:56px;height:56px;border-radius:7px;object-fit:cover;border:1px solid #2A2A2A;flex-shrink:0;}
.svc-footer{margin-top:auto;padding:14px 20px 18px;display:flex;align-items:center;justify-content:space-between;border-top:1px solid #2A2A2A;gap:8px;}
.svc-tap{font-size:12px;color:#A1A1AA;}
.svc-btn{border:none;cursor:pointer;padding:10px 20px;border-radius:8px;font-size:13px;font-weight:800;transition:opacity .18s;}
.svc-btn:hover{opacity:.85;}

